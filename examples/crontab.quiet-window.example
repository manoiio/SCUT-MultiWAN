# Router GMT+8; maintenance resumes at 07:00, USB at 07:01, ECMP at 07:02.
# Reference only: merge with actual router cron; do not blindly replace it.
0,5 0 * * * /usr/bin/native-watchdog >/dev/null 2>&1
0 7 * * * FORCE_SCAN=1 /usr/bin/native-watchdog >/tmp/native-watchdog-0700.log 2>&1
5,10,15,20,25,30,35,40,45,50,55 7 * * * /usr/bin/native-watchdog >/dev/null 2>&1
*/5 8-23 * * * /usr/bin/native-watchdog >/dev/null 2>&1
2 0 * * * /usr/bin/usb-watchdog >/dev/null 2>&1
1 7 * * * /usr/bin/usb-watchdog >/dev/null 2>&1
7,12,17,22,27,32,37,42,47,52,57 7 * * * /usr/bin/usb-watchdog >/dev/null 2>&1
2-57/5 8-23 * * * /usr/bin/usb-watchdog >/dev/null 2>&1
4 0 * * * /usr/bin/dualwan-refresh apply >/dev/null 2>&1
2 7 * * * /usr/bin/dualwan-refresh apply >/dev/null 2>&1
9,14,19,24,29,34,39,44,49,54,59 7 * * * /usr/bin/dualwan-refresh apply >/dev/null 2>&1
4-59/5 8-23 * * * /usr/bin/dualwan-refresh apply >/dev/null 2>&1
# New policy: ordinary workdays fail closed; allowed dates use low-frequency recovery.
# Two protected-period route-only health checks; no Portal or radio operation.
8,23 0 * * * /usr/bin/scut-night-watchdog route >/dev/null 2>&1
25,40,55 0 * * * /usr/bin/scut-night-watchdog native >/dev/null 2>&1
10,25,40,55 1-6 * * * /usr/bin/scut-night-watchdog native >/dev/null 2>&1
27,42,57 0 * * * /usr/bin/scut-night-watchdog usb >/dev/null 2>&1
12,27,42,57 1-6 * * * /usr/bin/scut-night-watchdog usb >/dev/null 2>&1
29,44,59 0 * * * /usr/bin/scut-night-watchdog route >/dev/null 2>&1
14,29,44,59 1-6 * * * /usr/bin/scut-night-watchdog route >/dev/null 2>&1
13 12 1 * * /usr/bin/scut-calendar-update >/dev/null 2>&1
