#!/bin/sh /etc/rc.common
USE_PROCD=1
start_service() {
    test -s /var/run/scut-lan/dns.conf || return 1
    procd_open_instance
    procd_set_param command /usr/sbin/dnsmasq --keep-in-foreground --conf-file=/var/run/scut-lan/dns.conf --pid-file=/var/run/scut-lan/dns.pid
    procd_set_param respawn 3600 5 5
    procd_set_param term_timeout 2
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
