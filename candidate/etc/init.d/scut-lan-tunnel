#!/bin/sh /etc/rc.common
START=98
STOP=9
USE_PROCD=1
start_service() {
    modprobe tun || return 1
    mkdir -p /var/run/scut-lan
    chmod 700 /var/run/scut-lan
    ip link show scut-lan >/dev/null 2>&1 || ip tuntap add dev scut-lan mode tun || return 1
    ip addr replace 172.31.255.2/30 dev scut-lan || return 1
    ip -6 addr replace fd70:7363:7574::2/126 dev scut-lan nodad || return 1
    ip link set scut-lan mtu 1400 up || return 1
    procd_open_instance
    procd_set_param command /usr/bin/scut-lan-tunnel -config /etc/scut-lan/tunnel.json
    procd_set_param env GOMEMLIMIT=24MiB GOGC=50
    procd_set_param respawn 3600 5 5
    procd_set_param term_timeout 3
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
stop_service() {
    rm -f /var/run/scut-lan/tunnel.ready
}
