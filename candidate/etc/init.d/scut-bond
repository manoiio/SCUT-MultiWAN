#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1
start_service() {
    procd_open_instance paths
    procd_set_param command /usr/bin/scut-bond-paths
    procd_set_param respawn 3600 10 5
    procd_set_param term_timeout 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
    procd_open_instance proxy
    procd_set_param command /usr/bin/scut-bond -config /etc/scut-bond/client.json
    procd_set_param env GOMEMLIMIT=24MiB GOGC=50
    procd_set_param respawn 3600 10 5
    procd_set_param term_timeout 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
