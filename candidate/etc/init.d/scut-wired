#!/bin/sh /etc/rc.common
START=95
STOP=15
USE_PROCD=1
start_service() {
    [ -f /etc/scut-wired.conf ] || return 0
    . /etc/scut-wired.conf
    [ "$WIRED_ENABLE" = 1 ] || return 0
    procd_open_instance
    procd_set_param command /usr/lib/scut-multiwan/wired-run
    procd_set_param respawn 3600 60 0
    procd_set_param stdout 0
    procd_set_param stderr 0
    procd_close_instance
}
# No wireless/wan6/DNS triggers: unrelated changes must not terminate wired auth.
reload_service() { return 0; }
stop_service() {
    # Resolve the current protocol child even for the first acceptance wrapper.
    [ -f /tmp/scut-wired-ready ] || return 0
    local pid started extra
    read -r pid started extra < /tmp/scut-wired-ready || return 0
    case "$pid:$started" in ''|*[!0-9:]*) return 0;; esac
    [ -n "$pid" ] && [ -n "$started" ] && [ -z "$extra" ] || return 0
    [ "$(awk '{print $22}' "/proc/$pid/stat" 2>/dev/null)" = "$started" ] || return 0
    [ "$(readlink "/proc/$pid/exe" 2>/dev/null)" = /usr/bin/scutclient-wired ] || return 0
    kill -TERM "$pid" 2>/dev/null || true
}
service_stopped() {
    /usr/bin/dualwan-refresh apply >/dev/null 2>&1 || true
}
