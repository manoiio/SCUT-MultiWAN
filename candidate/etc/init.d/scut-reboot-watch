#!/bin/sh /etc/rc.common
# Archive before S12log appends the next boot's messages.
START=11
STOP=90
USE_PROCD=1
start_service() {
    /usr/bin/scut-reboot-watch archive || return $?
    procd_open_instance
    procd_set_param command /usr/bin/scut-reboot-watch run
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 0
    procd_set_param stderr 1
    procd_set_param term_timeout 3
    procd_close_instance
}
