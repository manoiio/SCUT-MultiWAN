#!/bin/sh

. /usr/lib/scut-multiwan/common.sh || exit 1

mw_require_active || exit $?
mw_portal_lock 30 || exit $?
. /etc/campus-portal.conf

DEV="$1"

if [ -z "$DEV" ]; then
    echo "Usage: campus-portal-logout <device>"
    exit 1
fi

case "$DEV" in
    phy0-sta*|phy2-sta*|phy3-sta*|mtusb*)
        USER="$NATIVE_USER"
        ;;
    *)
        echo "Unsupported device: $DEV"
        exit 1
        ;;
esac

log() {
    logger -t campus-portal "$*"
    echo "$*"
}

IP="$(
    ip -4 -o addr show dev "$DEV" scope global 2>/dev/null |
    awk 'NR==1 {
        split($4,a,"/")
        print a[1]
    }'
)"

if [ -z "$IP" ] && [ -z "$2" ]; then
    log "$DEV: no IPv4 address"
    exit 1
fi

SOURCE_IP=$IP
case "$DEV" in phy0-sta*|phy2-sta*) ;; *) SOURCE_IP=;; esac


case "$DEV" in
    phy0-sta*|phy2-sta*) ;;
    *) [ -n "$2" ] || exit 1;;
esac
if [ -n "$2" ]; then
    mw_session_read native || exit 75
    [ "$MW_SESSION_IP" = "$2" ] || exit 75
    IP="$2"
fi
mw_ipv4 "$IP" || exit 1
mw_require_active 20 || exit $?

IP_INT="$(
    printf '%s\n' "$IP" |
    awk -F. '{
        printf "%.0f\n",
        $1 * 16777216 +
        $2 * 65536 +
        $3 * 256 +
        $4
    }'
)"

case "$USER" in
    *@wifi)
        ACCOUNT="$USER"
        ;;
    *)
        ACCOUNT="${USER}@wifi"
        ;;
esac

# Type 1 is source-local. A missing/changed source cannot safely release an
# older journal IP this way, even with wlan_user_ip set to that older IP.
if [ "$SOURCE_IP" != "$IP" ]; then
    . /usr/lib/scut-multiwan/remote-release.sh || exit 75
    mw_remote_release_logged native "$IP" "$ACCOUNT"
    exit $?
fi

log "$DEV: IP=$IP integer=$IP_INT"

RESPONSE="$(
    curl -4 \
        --interface "$DEV" \
        --silent \
        --show-error \
        --max-time 10 \
        --max-filesize 1048576 \
        --referer 'https://s.scut.edu.cn/' \
        --get \
        --data-urlencode 'callback=dr1002' \
        --data-urlencode "user_account=$ACCOUNT" \
        --data-urlencode 'wlan_user_mac=000000000000' \
        --data-urlencode "wlan_user_ip=$IP_INT" \
        --data-urlencode 'unbind_type=1' \
        --data-urlencode 'jsVersion=4.1.3' \
        --data-urlencode 'program_index=aGPKgC1754462770' \
        --data-urlencode 'page_index=OYOGQG1754463397' \
        --data-urlencode 'v=5947' \
        --data-urlencode 'lang=zh' \
        'https://s.scut.edu.cn:802/eportal/portal/mac/unbind' 2>&1
)"
CURL_RC=$?
# Only a complete response can confirm this mutation; retain the journal on
# overflow/timeout/transport errors, even if a partial body says result=1.
if [ "$CURL_RC" -ne 0 ]; then
    RESPONSE=
    logger -t campus-portal "$DEV: Portal response incomplete curl=$CURL_RC; session retained"
    exit 1
fi


: # Do not store an unfiltered Portal response.

if printf '%s\n' "$RESPONSE" |
    grep -Eq '"result"[[:space:]]*:[[:space:]]*1[[:space:]]*[,}]'; then

    mw_session_clear native "$IP" || exit 1
    log "$DEV: Portal logout successful"
    exit 0

fi

if mw_portal_empty "$RESPONSE"; then
    mw_confirm_absent native "$DEV" "$IP" "$RESPONSE"
    exit $?
fi
log "$DEV: Portal logout failed"

exit 1
