#!/bin/sh
. /usr/lib/scut-multiwan/common.sh || exit 1
DEV="$1"
case "$DEV" in phy0-sta*|phy2-sta*) ;; *) exit 0;; esac
mw_require_scan 15 || exit $?
mw_lock "qca-$DEV" 7 || exit $?
trap 'exit 130' INT
trap 'exit 143' TERM
STATE_DIR=/tmp/qca-fixed-rate
mkdir -p "$STATE_DIR" || exit 1
STATE_FILE="$STATE_DIR/$DEV.state"
is_uint() { case "$1" in ''|*[!0-9]*) return 1;; *) return 0;; esac; }
set_rate() {
    mw_require_scan 5 || return $?
    iw dev "$DEV" set bitrates legacy-5 6 ht-mcs-5 0 vht-mcs-5 he-mcs-5 2:"$1"
}
link_key() {
    iw dev "$DEV" link 2>/dev/null |
        awk '/^Connected to / {b=$3} $1=="freq:" {f=int($2)} END {if(b!=""&&f!="")print b "@" f}'
}
# One parser per dump, instead of repeatedly spawning awk/grep for each field.
metrics() {
    iw dev "$DEV" station dump 2>/dev/null | awk '
      BEGIN {age=tx=rx=pk=fail=rp="?"; assoc="?"; sig="?"}
      $1=="connected"&&$2=="time:" {age=$3}
      $1=="associated"&&$2=="at"&&$3=="[boottime]:" {assoc=$4}
      $1=="tx"&&$2=="packets:" {pk=$3}
      $1=="tx"&&$2=="failed:" {fail=$3}
      $1=="rx"&&$2=="packets:" {rp=$3}
      $1=="signal"&&$2=="avg:" {sig=$3}
      $1=="tx"&&$2=="bitrate:" {for(i=1;i<=NF;i++)if($i=="HE-MCS")tx=$(i+1)}
      $1=="rx"&&$2=="bitrate:" {for(i=1;i<=NF;i++)if($i=="HE-MCS")rx=$(i+1)}
      END {print age,tx,rx,pk,fail,rp,assoc,sig}'
}
LINK_KEY="$(link_key)"; [ -n "$LINK_KEY" ] || exit 1
read -r AGE CURRENT_TX RX CURRENT_PACKETS CURRENT_FAILED RP ASSOC SIGNAL <<EOF
$(metrics)
EOF
NOW="$(mw_uptime)"
read -r LAST_LINK LAST_TARGET PREV_PACKETS PREV_FAILED GOOD_SINCE LAST_CHECK LAST_ASSOC LOW_COUNT COOLDOWN <<EOF
$(awk '{printf "%s ", $0}' "$STATE_FILE" 2>/dev/null)
EOF
for field in GOOD_SINCE LAST_CHECK LOW_COUNT COOLDOWN; do
    eval 'value=${'"$field"':-}'
    is_uint "$value" || eval "$field=0"
done
GAP=$((NOW-LAST_CHECK))
RESET=0
[ "$LAST_LINK" = "$LINK_KEY" ] && [ "$LAST_ASSOC" = "$ASSOC" ] || RESET=1
[ "$GAP" -ge 0 ] && [ "$GAP" -le 90 ] || RESET=1
if [ "$RESET" = 1 ]; then GOOD_SINCE=0; LOW_COUNT=0; PREV_PACKETS=; PREV_FAILED=; fi
[ "$GOOD_SINCE" -le "$NOW" ] || GOOD_SINCE=0
[ "$COOLDOWN" -le $((NOW+900)) ] || COOLDOWN=0
WARMUP=0
if is_uint "$AGE" && [ "$AGE" -lt 15 ]; then WARMUP=1; GOOD_SINCE=0; LOW_COUNT=0; fi
SEVERE=0; DPK=na; DF=na
if is_uint "$CURRENT_PACKETS" && is_uint "$CURRENT_FAILED" &&
   is_uint "$PREV_PACKETS" && is_uint "$PREV_FAILED"; then
    if [ "$CURRENT_PACKETS" -lt "$PREV_PACKETS" ] || [ "$CURRENT_FAILED" -lt "$PREV_FAILED" ]; then
        GOOD_SINCE=0; LOW_COUNT=0
    else
        DPK=$((CURRENT_PACKETS-PREV_PACKETS)); DF=$((CURRENT_FAILED-PREV_FAILED))
        [ "$DF" -lt 20 ] || [ $((DF*10)) -lt "$DPK" ] || SEVERE=1
    fi
fi
BASE=
case "$LAST_TARGET" in 7|9) [ "$LAST_LINK" != "$LINK_KEY" ] || BASE="$LAST_TARGET";; esac
if [ -z "$BASE" ]; then case "$CURRENT_TX" in 7|9) BASE="$CURRENT_TX";; *) BASE=7;; esac; fi
REASON=normal
if is_uint "$CURRENT_TX" && [ "$CURRENT_TX" -gt 9 ]; then
    BASE=9; SEVERE=0; REASON=precap-to-9
fi
# Restore the mask before sampling (including legacy-rate/mask-loss cases).
set_rate "$BASE" || exit $?
if [ "$BASE" = 9 ] && [ "$SEVERE" = 1 ]; then
    set_rate 7 || exit $?
    BASE=7; GOOD_SINCE=0; COOLDOWN=$((NOW+300)); REASON=severe-tx-failure
fi
GW="$(ip -4 route show dev "$DEV" | awk '$1=="default" {print $3; exit}')"
PROBES=0; REPLIES=0; SAMPLES=; VALID=0; LAST_RP="$RP"; RTT=
I=0
while [ "$I" -lt 5 ]; do
    mw_require_scan 3 || exit $?
    if mw_ipv4 "$GW"; then
        PROBES=$((PROBES+1))
        PING="$(ping -I "$DEV" -c 1 -W 1 "$GW" 2>/dev/null)"; PRC=$?
        if [ "$PRC" = 0 ]; then
            REPLIES=$((REPLIES+1))
            R="$(printf '%s\n' "$PING" | awk '/time[=<]/ {for(i=1;i<=NF;i++)if($i~/^time[=<]/){sub(/^time[=<]/,"",$i);print $i;exit}}')"
            [ -z "$R" ] || RTT="$RTT $R"
        fi
    fi
    read -r A T RX PK F RP AS S <<EOF
$(metrics)
EOF
    [ "$AS" = "$ASSOC" ] || exit 75
    # Missing/stale packet counters cannot turn idle RX readings into evidence.
    if is_uint "$RX" && [ "$RX" -le 11 ] && is_uint "$RP" &&
       is_uint "$LAST_RP" && [ "$RP" -gt "$LAST_RP" ]; then
        SAMPLES="$SAMPLES $RX"; VALID=$((VALID+1))
    fi
    LAST_RP="$RP"
    I=$((I+1)); [ "$I" -ge 5 ] || sleep 1
done
MEDIAN="$(for r in $SAMPLES; do echo "$r"; done | sort -n | awk '{a[NR]=$1} END {if(NR)print a[int((NR+1)/2)]}')"
TARGET="$BASE"; NOW="$(mw_uptime)"
# Include failures during this round, not only those between rounds.
if is_uint "$PK" && is_uint "$F" && is_uint "$CURRENT_PACKETS" && is_uint "$CURRENT_FAILED" &&
   [ "$PK" -ge "$CURRENT_PACKETS" ] && [ "$F" -ge "$CURRENT_FAILED" ]; then
    d=$((F-CURRENT_FAILED)); p=$((PK-CURRENT_PACKETS))
    [ "$d" -lt 20 ] || [ $((d*10)) -lt "$p" ] || SEVERE=1
fi
if [ "$BASE" = 9 ]; then
    GOOD_SINCE=0
    if [ "$SEVERE" = 1 ] || { [ "$PROBES" = 5 ] && [ "$REPLIES" -le 3 ]; }; then
        TARGET=7; LOW_COUNT=0; COOLDOWN=$((NOW+300)); REASON=tx-or-gateway-failure
    elif [ "$WARMUP" = 0 ] && [ "$VALID" -ge 3 ] && [ "$MEDIAN" -lt 9 ]; then
        LOW_COUNT=$((LOW_COUNT+1))
        if [ "$LOW_COUNT" -ge 2 ]; then TARGET=7; COOLDOWN=$((NOW+300)); REASON=persistent-low-rx; fi
    else LOW_COUNT=0; fi
else
    LOW_COUNT=0
    if [ "$WARMUP" = 0 ] && [ "$VALID" -ge 3 ] && [ "$MEDIAN" -ge 9 ] &&
       [ "$REPLIES" -ge 4 ] && [ "$SEVERE" = 0 ] && [ "$NOW" -ge "$COOLDOWN" ]; then
        if [ "$GOOD_SINCE" = 0 ]; then GOOD_SINCE="$NOW"; REASON=candidate-start
        elif [ $((NOW-GOOD_SINCE)) -ge 300 ]; then TARGET=9; REASON=candidate-5min
        else REASON=candidate-wait; fi
    else GOOD_SINCE=0; fi
fi
# A roam during the samples cancels this decision before changing the new link.
[ "$(link_key)" = "$LINK_KEY" ] || exit 75
[ "$TARGET" = "$BASE" ] || set_rate "$TARGET" || exit $?
if [ "$BASE" = 7 ] && [ "$TARGET" = 9 ]; then
    BEFORE="$F"; OK=0; I=0
    while [ "$I" -lt 5 ]; do
        mw_require_scan 3 || exit $?
        ping -I "$DEV" -c 1 -W 1 "$GW" >/dev/null 2>&1 && OK=$((OK+1))
        I=$((I+1))
    done
    read -r A T RX PK F RP AS S <<EOF
$(metrics)
EOF
    [ "$AS" = "$ASSOC" ] && [ "$(link_key)" = "$LINK_KEY" ] || exit 75
    BAD=0
    [ "$OK" -ge 4 ] || BAD=1
    if is_uint "$BEFORE" && is_uint "$F" && [ "$F" -ge "$BEFORE" ] && [ $((F-BEFORE)) -ge 3 ]; then BAD=1; fi
    if [ "$BAD" = 1 ]; then
        set_rate 7 || exit $?
        TARGET=7; COOLDOWN=$((NOW+600)); REASON=promotion-failed
    else REASON=promotion-validated; fi
    GOOD_SINCE=0
fi
read -r A T RX PK F RP AS S <<EOF
$(metrics)
EOF
[ "$AS" = "$ASSOC" ] && [ "$(link_key)" = "$LINK_KEY" ] || exit 75
is_uint "$PK" || PK=0; is_uint "$F" || F=0
TMP="$STATE_FILE.$$"
printf '%s\n%s\n%s\n%s\n%s\n%s\n%s\n%s\n%s\n' "$LINK_KEY" "$TARGET" "$PK" "$F" "$GOOD_SINCE" "$NOW" "$ASSOC" "$LOW_COUNT" "$COOLDOWN" > "$TMP" && mv "$TMP" "$STATE_FILE" || exit 1
# State changes and candidate starts are useful; stable minutes do not fill logs.
if [ "$TARGET" != "$LAST_TARGET" ] || { [ "$REASON" != normal ] && [ "$REASON" != candidate-wait ]; }; then
    logger -t qca-fixed-rate "$DEV signal=$SIGNAL tx=$CURRENT_TX rx=${MEDIAN:-unknown} valid=$VALID warmup=$WARMUP gw=$REPLIES/$PROBES rtt='${RTT# }' dfailed=$DF dpkts=$DPK -> MCS$TARGET reason=$REASON"
fi
